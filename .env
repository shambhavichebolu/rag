
# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval Configuration
TOP_K=5

# LLM Configuration
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7